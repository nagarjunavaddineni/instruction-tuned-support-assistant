MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
CLASSIFIER_MODEL=distilbert/distilbert-base-uncased
MAX_SEQ_LENGTH=512
NUM_EPOCHS=2
TRAIN_BATCH_SIZE=2
